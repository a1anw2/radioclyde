node_modules/

# Real config holds secrets (icecast source password, Plex token, Exa key) —
# copy config.example.json to config.json and fill in real values locally.
config.json

# All radio data (schedule.json, show-descriptions/*.md, generated output
# trees, history, logs, playlists, cache) lives outside the repo under
# dataDir (see config.json), not here -- nothing left in-repo to ignore.

# Generated at runtime, not source
.env

# Android TV app (android-tv/) — standard Android Gradle project ignores
android-tv/local.properties
android-tv/.gradle/
android-tv/.idea/
android-tv/*.iml
android-tv/app/*.iml
android-tv/app/build/
android-tv/build/
android-tv/captures/
android-tv/.cxx/
android-tv/local.settings.json

# Local dev device inventory (LAN IP:port for adb network debugging) --
# machine-specific, not shared/checked in.
android-tv/devices.json

# Android mobile app (android-mobile/) — standard Android Gradle project ignores
android-mobile/local.properties
android-mobile/.gradle/
android-mobile/.idea/
android-mobile/*.iml
android-mobile/app/*.iml
android-mobile/app/build/
android-mobile/build/
android-mobile/captures/
android-mobile/.cxx/
